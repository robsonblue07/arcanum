# Copie este arquivo para `.env` e preencha com as chaves do projeto Supabase.
# No Expo, as variáveis de cliente precisam do prefixo EXPO_PUBLIC_.

# Equivale a NEXT_PUBLIC_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Equivale a ANON_KEY (chave publishable/anon)
EXPO_PUBLIC_ANON_KEY=your-anon-key

# Secrets das Edge Functions (Dashboard > Edge Functions > Secrets, não no app):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_LIFETIME=
# STRIPE_PRICE_MONTHLY=
# CHECKOUT_WEB_ORIGIN=https://arcanum.app

